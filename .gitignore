# Third-party repos (read-only reference)
reference/

# Downloaded third-party mods (never commit)
downloaded_mods/
BG3ModManager_Latest/
BG3SE-Updater-*/

# Build output and local backups
build/
backups/
*.pak

# LSLib tools (downloaded, not committed)
tools/lslib/

# Ghidra MCP source clone (built on the fly; too large to track)
tools/ghidra-mcp-src/

# Logs copied from the game
logs/

# Never commit game files or decompiled output
*.exe
*.dll
ghidra/
decompiled/

# Local Claude Code copy of the project skills; the canonical copy lives in setup/skills/.
.claude/

# Editor and OS
.vscode/
Thumbs.db
desktop.ini

# patches/*/ transient outputs (apply status + rendered commit message).
# The source files (Lua, apply.ps1, manifest.txt) are checked in; these
# two are per-run artefacts that would just churn the repo.
patches/**/apply.result
patches/**/commit-msg.txt
