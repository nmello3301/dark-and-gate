# Writes build_info.h with the DLL's build stamp, "<git hash>[+dirty]-<UTC
# time>", for the multiplayer version handshake (every player must run the
# same DLL; SelfCheck.cpp, docs/design/multiplayer.md). Runs on every build
# (the dag_build_info target); the header only changes when the stamp does.
# The same header feeds src/DarkAndGate.rc (the DLL's version resource), so
# it uses an include guard (rc.exe doesn't know #pragma once) and only
# #defines.
#   cmake -DSRC=<repo dir> -DOUT=<header path> -DVER=<major.minor.patch> -P BuildInfo.cmake
execute_process(COMMAND git -C "${SRC}" rev-parse --short HEAD
                OUTPUT_VARIABLE GIT_HASH OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no
                OUTPUT_VARIABLE GIT_DIRTY ERROR_QUIET)
if(NOT GIT_HASH)
    set(GIT_HASH "nogit")
endif()
if(GIT_DIRTY)
    set(DIRTY "+dirty")
else()
    set(DIRTY "")
endif()
if(NOT VER)
    set(VER "0.0.0")
endif()
string(REPLACE "." "," VER_NUM "${VER}")
string(TIMESTAMP NOW "%Y%m%dT%H%M%SZ" UTC)
set(STAMP "${GIT_HASH}${DIRTY}-${NOW}")
file(WRITE "${OUT}.tmp" "// Generated by cmake/BuildInfo.cmake on every build. Do not edit.
#ifndef DAG_BUILD_INFO_H
#define DAG_BUILD_INFO_H
#define DAG_DLL_BUILD \"${STAMP}\"
#define DAG_DLL_VERSION_NUM ${VER_NUM},0
#define DAG_DLL_VERSION_STR \"${VER}+${STAMP}\"
#endif
")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
