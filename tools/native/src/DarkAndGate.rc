// SPDX-License-Identifier: GPL-3.0-or-later
// Version resource for DarkAndGate.dll: what Explorer shows under
// Properties > Details, and what antivirus reputation checks read. The
// version and the build stamp come from build_info.h (cmake/BuildInfo.cmake),
// regenerated on every build.
#include <winver.h>
#include "build_info.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DAG_DLL_VERSION_NUM
 PRODUCTVERSION DAG_DLL_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nick (Dark and Gate)"
            VALUE "FileDescription", "Dark and Gate - native plugin for Baldur's Gate 3"
            VALUE "FileVersion", DAG_DLL_VERSION_STR
            VALUE "InternalName", "DarkAndGate"
            VALUE "LegalCopyright", "Copyright (C) 2026 Nick. GPL-3.0-or-later."
            VALUE "OriginalFilename", "DarkAndGate.dll"
            VALUE "ProductName", "Dark and Gate"
            VALUE "ProductVersion", DAG_DLL_VERSION_STR
            VALUE "Comments", "Open source: https://github.com/nmello3301/dark-and-gate. Loaded by Ch4nKyy's Mod Loader from bin\\NativeMods."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
